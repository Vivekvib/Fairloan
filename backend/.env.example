# Copy this file to .env and fill in your values
# Never commit .env to git

# Use SQLite for local dev: sqlite:///./fairloan_dev.db
# Use PostgreSQL for production: postgresql://user:password@host:5432/fairloan
DATABASE_URL=sqlite:///./fairloan_dev.db

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# App settings
APP_ENV=development
DEBUG=true
